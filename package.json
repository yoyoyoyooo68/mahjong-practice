{
  "name": "mahjong-practice",
  "version": "0.1.0",
  "private": true,
  "description": "日本式リーチ麻雀をCPUと打って練習できるWebアプリ",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "sim": "node scripts/simulate.js",
    "serve": "python3 -m http.server 5180"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
